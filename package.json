{
  "name": "440-automation-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm install && npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/src/server.ts",
    "build": "npm run build:frontend",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "start": "tsx server/src/server.ts"
  },
  "dependencies": {
    "axios": "^1.6.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "openai": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sentiment": "^5.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.1.1",
    "typescript": "^5.6.2",
    "vite": "^8.0.5"
  }
}
